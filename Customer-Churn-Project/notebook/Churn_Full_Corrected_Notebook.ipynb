    "def net_benefit(tp, fp):\n",
    "    return SUCCESS_RATE * VALUE_SAVED * tp - OFFER_COST * (tp + fp)\n",
    "\n",
    "thr_grid = np.linspace(0.05, 0.95, 91)\n",
    "thr_rows, curves = [], {}\n",
    "for name, gs in fitted_smote.items():\n",
    "    oof = cross_val_predict(gs.best_estimator_, X_train, y_train, cv=cv, method=\"predict_proba\")[:, 1]\n",
    "    nbs = []\n",
    "    for t in thr_grid:\n",
    "        p = (oof >= t).astype(int)\n",
    "        tp = int(((p == 1) & (y_train.values == 1)).sum()); fp = int(((p == 1) & (y_train.values == 0)).sum())\n",
    "        nbs.append(net_benefit(tp, fp))\n",
    "    curves[name] = np.array(nbs)\n",
    "    best_t = float(thr_grid[int(np.argmax(nbs))])\n",
    "    m0, m1 = test_metrics(y_test, test_probas[name], 0.5), test_metrics(y_test, test_probas[name], best_t)\n",
    "    thr_rows.append({\"Model\": name, \"Chosen threshold\": round(best_t, 2),\n",
    "                     \"Recall @0.5\": round(m0[\"Recall\"], 3), \"Precision @0.5\": round(m0[\"Precision\"], 3),\n",
    "                     \"Net benefit @0.5 (GBP)\": round(net_benefit(m0[\"TP\"], m0[\"FP\"])),\n",
    "                     \"Recall @chosen\": round(m1[\"Recall\"], 3), \"Precision @chosen\": round(m1[\"Precision\"], 3),\n",
    "                     \"Net benefit @chosen (GBP)\": round(net_benefit(m1[\"TP\"], m1[\"FP\"]))})\n",
    "thr_table = pd.DataFrame(thr_rows)\n",
    "thr_table.to_csv(\"results/threshold_analysis.csv\", index=False)\n",
    "\n",
    "plt.figure(figsize=(7, 4.5))\n",
    "for n, v in curves.items(): plt.plot(thr_grid, v, label=n)\n",
    "plt.xlabel(\"Decision threshold\"); plt.ylabel(\"Net benefit on training data (GBP, hypothetical)\")\n",
    "plt.title(\"Net benefit by threshold (out-of-fold predictions)\"); plt.legend()\n",
    "savefig(\"fig_net_benefit_threshold\")\n",
    "thr_table"
   ]
  },
