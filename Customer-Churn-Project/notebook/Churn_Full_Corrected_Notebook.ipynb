   "source": [
    "df = pd.read_csv(CSV_PATH)\n",
    "print(\"Raw shape:\", df.shape)\n",
    "df[\"TotalCharges\"] = pd.to_numeric(df[\"TotalCharges\"], errors=\"coerce\")\n",
    "print(\"Rows with non-numeric TotalCharges (removed):\", df[\"TotalCharges\"].isna().sum())\n",
    "print(\"Duplicate rows:\", df.duplicated().sum())\n",
    "df = df.dropna(subset=[\"TotalCharges\"]).reset_index(drop=True)\n",
    "df = df.drop(columns=[\"customerID\"])\n",
    "print(\"Cleaned shape:\", df.shape)\n",
    "print(df[\"Churn\"].value_counts().to_string())\n",
    "print(\"Churn rate: {:.2%}\".format((df[\"Churn\"] == \"Yes\").mean()))\n",
    "\n",
    "y = (df[\"Churn\"] == \"Yes\").astype(int)\n",
    "X = df.drop(columns=[\"Churn\"]).copy()\n",
    "X[\"SeniorCitizen\"] = X[\"SeniorCitizen\"].astype(str)     # treated as a category\n",
    "\n",
    "numeric_features = [\"tenure\", \"MonthlyCharges\", \"TotalCharges\"]\n",
    "categorical_features = [c for c in X.columns if c not in numeric_features]\n",
    "print(\"\\nNumeric:\", numeric_features)\n",
    "print(\"Categorical:\", categorical_features)\n",
    "\n",
    "desc = df.groupby(\"Churn\")[numeric_features].mean().T.round(2)\n",
    "desc.insert(0, \"All customers\", df[numeric_features].mean().round(2))\n",
    "desc.to_csv(\"results/descriptive_means.csv\")\n",
    "desc"
   ]
