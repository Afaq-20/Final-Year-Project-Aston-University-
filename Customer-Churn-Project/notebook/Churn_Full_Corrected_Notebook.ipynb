   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Train/test split and preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train: 5625 (1495 churners, 26.58%)\n",
      "Test : 1407 (374 churners, 26.58%)\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 990x385 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "After SMOTE (illustration): {0: 4130, 1: 4130}\n"
     ]
    }
   ],
   "source": [
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, stratify=y, random_state=SEED)\n",
    "print(f\"Train: {len(X_train)} ({y_train.sum()} churners, {y_train.mean():.2%})\")\n",
    "print(f\"Test : {len(X_test)} ({y_test.sum()} churners, {y_test.mean():.2%})\")\n",
    "\n",
    "preprocessor = ColumnTransformer([\n",
    "    (\"num\", Pipeline([(\"imp\", SimpleImputer(strategy=\"median\")), (\"sc\", StandardScaler())]), numeric_features),\n",
    "    (\"cat\", Pipeline([(\"imp\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "                      (\"oh\", OneHotEncoder(handle_unknown=\"ignore\"))]), categorical_features),\n",
    "])\n",
    "cv = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)\n",
    "pos_weight = (y_train == 0).sum() / (y_train == 1).sum()\n",
    "\n",
    "# Illustration only (for the SMOTE figure): this is NOT used for model selection\n",
    "prep_demo = clone(preprocessor).fit(X_train)\n",
    "Xt_demo = prep_demo.transform(X_train)\n",
    "Xr_demo, yr_demo = SMOTE(random_state=SEED).fit_resample(Xt_demo, y_train)\n",
    "fig, axes = plt.subplots(1, 2, figsize=(9, 3.5))\n",
    "sns.countplot(x=y_train.values, palette=\"Set2\", ax=axes[0]); axes[0].set_title(\"Training class distribution before SMOTE\")\n",
    "sns.countplot(x=np.asarray(yr_demo), palette=\"Set2\", ax=axes[1]); axes[1].set_title(\"Training class distribution after SMOTE\")\n",
    "for ax in axes: ax.set_xlabel(\"Churn (0 = no, 1 = yes)\")\n",
    "savefig(\"fig_smote_before_after\")\n",
    "print(\"After SMOTE (illustration):\", pd.Series(np.asarray(yr_demo)).value_counts().to_dict())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Models, search spaces and the corrected pipeline\n",
    "\n",
    "* Preprocessing + SMOTE + classifier are **one pipeline**, so SMOTE is applied only to the training part of each cross-validation fold.\n",
    "* **Logistic Regression is now tuned too** (parameter `C`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_models(balanced=False):\n",
    "    cw = \"balanced\" if balanced else None\n",
    "    if FAST:\n",
    "        return {\n",
    "            \"Logistic Regression\": (LogisticRegression(max_iter=2000, class_weight=cw, random_state=SEED), {\"clf__C\": [0.1, 1, 10]}),\n",
    "            \"Decision Tree\": (DecisionTreeClassifier(class_weight=cw, random_state=SEED), {\"clf__max_depth\": [4, 6], \"clf__min_samples_split\": [10]}),\n",
    "            \"Random Forest\": (RandomForestClassifier(class_weight=cw, random_state=SEED, n_jobs=1), {\"clf__n_estimators\": [50], \"clf__max_depth\": [6, 8]}),\n",
    "            \"XGBoost\": (XGBClassifier(eval_metric=\"logloss\", random_state=SEED, n_jobs=1, scale_pos_weight=(pos_weight if balanced else 1.0)),\n",
    "                        {\"clf__n_estimators\": [50], \"clf__max_depth\": [3], \"clf__learning_rate\": [0.1]}),\n",
    "        }\n",
    "    return {\n",
    "        \"Logistic Regression\": (LogisticRegression(max_iter=2000, class_weight=cw, random_state=SEED),\n",
    "                                {\"clf__C\": [0.01, 0.1, 1, 10, 100]}),\n",
    "        \"Decision Tree\": (DecisionTreeClassifier(class_weight=cw, random_state=SEED),\n",
    "                          {\"clf__max_depth\": [4, 6, 8, 10], \"clf__min_samples_split\": [10, 20, 30]}),\n",
    "        \"Random Forest\": (RandomForestClassifier(class_weight=cw, random_state=SEED, n_jobs=1),\n",
    "                          {\"clf__n_estimators\": [100, 200], \"clf__max_depth\": [6, 8, 10], \"clf__min_samples_split\": [10, 20]}),\n",
    "        \"XGBoost\": (XGBClassifier(eval_metric=\"logloss\", random_state=SEED, n_jobs=1,\n",
    "                                  scale_pos_weight=(pos_weight if balanced else 1.0)),\n",
    "                    {\"clf__n_estimators\": [100, 150], \"clf__max_depth\": [3, 5, 7], \"clf__learning_rate\": [0.05, 0.1]}),\n",
    "    }\n",
    "\n",
    "def build_pipeline(clf, use_smote):\n",
    "    steps = [(\"prep\", preprocessor)]\n",
    "    if use_smote:\n",
    "        steps.append((\"smote\", SMOTE(random_state=SEED)))   # applied ONLY inside each training fold\n",
    "    steps.append((\"clf\", clf))\n",
    "    return ImbPipeline(steps)\n",
    "\n",
    "def fit_all(use_smote):\n",
    "    fitted, rows = {}, []\n",
    "    for name, (clf, grid) in make_models(balanced=not use_smote).items():\n",
    "        print(\"Tuning\", name, \"...\")\n",
    "        gs = GridSearchCV(build_pipeline(clf, use_smote), grid, cv=cv,\n",
    "                          scoring={\"recall\": \"recall\", \"roc_auc\": \"roc_auc\", \"f1\": \"f1\"},\n",
    "                          refit=REFIT_METRIC, n_jobs=-1)\n",
    "        gs.fit(X_train, y_train)\n",
    "        fitted[name] = gs\n",
    "        b = gs.best_index_\n",
    "        rows.append({\"Model\": name,\n",
    "                     \"Selected parameters\": {k.replace(\"clf__\", \"\"): v for k, v in gs.best_params_.items()},\n",
    "                     \"CV recall\": round(gs.cv_results_[\"mean_test_recall\"][b], 4),\n",
    "                     \"CV ROC-AUC\": round(gs.cv_results_[\"mean_test_roc_auc\"][b], 4),\n",
    "                     \"CV F1\": round(gs.cv_results_[\"mean_test_f1\"][b], 4)})\n",
    "    return fitted, pd.DataFrame(rows)\n",
    "\n",
    "def test_metrics(y_true, proba, thr=0.5):\n",
    "    pred = (proba >= thr).astype(int)\n",
    "    tn, fp, fn, tp = confusion_matrix(y_true, pred).ravel()\n",
    "    return {\"Accuracy\": accuracy_score(y_true, pred), \"Precision\": precision_score(y_true, pred, zero_division=0),\n",
    "            \"Recall\": recall_score(y_true, pred), \"F1\": f1_score(y_true, pred),\n",
    "            \"ROC-AUC\": roc_auc_score(y_true, proba), \"PR-AUC\": average_precision_score(y_true, proba),\n",
    "            \"Balanced Acc\": balanced_accuracy_score(y_true, pred), \"MCC\": matthews_corrcoef(y_true, pred),\n",
    "            \"TP\": int(tp), \"FP\": int(fp), \"FN\": int(fn), \"TN\": int(tn)}"
   ]
  },
