    "rng = np.random.default_rng(SEED)\n",
    "y_arr = y_test.to_numpy()\n",
    "idx_all = [rng.integers(0, len(y_arr), len(y_arr)) for _ in range(N_BOOT)]\n",
    "boot = {n: {\"Recall\": [], \"Precision\": [], \"F1\": [], \"ROC-AUC\": []} for n in test_probas}\n",
    "for idx in idx_all:\n",
    "    yb = y_arr[idx]\n",
    "    if yb.min() == yb.max(): continue\n",
    "    for n, p in test_probas.items():\n",
    "        pb = p[idx]; pr_ = (pb >= 0.5).astype(int)\n",
    "        boot[n][\"Recall\"].append(recall_score(yb, pr_)); boot[n][\"Precision\"].append(precision_score(yb, pr_, zero_division=0))\n",
    "        boot[n][\"F1\"].append(f1_score(yb, pr_)); boot[n][\"ROC-AUC\"].append(roc_auc_score(yb, pb))\n",
    "ci_rows = []\n",
    "for n, d in boot.items():\n",
    "    row = {\"Model\": n}\n",
    "    for k, v in d.items():\n",
    "        lo, hi = np.percentile(v, [2.5, 97.5]); row[k] = f\"{np.mean(v):.3f} [{lo:.3f}, {hi:.3f}]\"\n",
    "    ci_rows.append(row)\n",
    "ci_table = pd.DataFrame(ci_rows); ci_table.to_csv(\"results/bootstrap_ci.csv\", index=False)\n",
    "\n",
    "names = list(test_probas); diff_rows = []\n",
    "for i in range(len(names)):\n",
    "    for j in range(i + 1, len(names)):\n",
    "        d = []\n",
    "        for idx in idx_all:\n",
    "            yb = y_arr[idx]\n",
    "            if yb.min() == yb.max(): continue\n",
    "            d.append(roc_auc_score(yb, test_probas[names[i]][idx]) - roc_auc_score(yb, test_probas[names[j]][idx]))\n",
    "        lo, hi = np.percentile(d, [2.5, 97.5])\n",
    "        diff_rows.append({\"Comparison\": f\"{names[i]} - {names[j]}\", \"ROC-AUC difference\": round(np.mean(d), 4),\n",
    "                          \"95% CI\": f\"[{lo:+.4f}, {hi:+.4f}]\", \"Clear difference?\": \"yes\" if (lo > 0 or hi < 0) else \"no (interval includes 0)\"})\n",
    "diff_table = pd.DataFrame(diff_rows); diff_table.to_csv(\"results/paired_auc_differences.csv\", index=False)\n",
    "display(ci_table); display(diff_table)"
   ]
  },
