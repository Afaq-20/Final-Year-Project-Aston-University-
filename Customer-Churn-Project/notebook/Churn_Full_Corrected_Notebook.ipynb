    "fair_rows = []\n",
    "for name, p in test_probas.items():\n",
    "    pred = (p >= 0.5).astype(int)\n",
    "    for attr in [\"gender\", \"SeniorCitizen\"]:\n",
    "        for grp in sorted(X_test[attr].unique()):\n",
    "            mask = (X_test[attr] == grp).to_numpy()\n",
    "            yt, yp = y_arr[mask], pred[mask]\n",
    "            fair_rows.append({\"Model\": name, \"Attribute\": attr, \"Group\": grp, \"n\": int(mask.sum()),\n",
    "                              \"Churn rate\": round(yt.mean(), 3), \"Flagged rate\": round(yp.mean(), 3),\n",
    "                              \"Recall\": round(recall_score(yt, yp), 3) if yt.sum() else np.nan,\n",
    "                              \"False-positive rate\": round(((yp == 1) & (yt == 0)).sum() / max((yt == 0).sum(), 1), 3)})\n",
    "fair_table = pd.DataFrame(fair_rows); fair_table.to_csv(\"results/fairness_check.csv\", index=False)\n",
    "fair_table"
   ]
