   "source": [
    "corr = df[numeric_features].assign(Churn=y).corr()\n",
    "plt.figure(figsize=(6, 5))\n",
    "sns.heatmap(corr, annot=True, fmt=\".2f\", cmap=\"coolwarm\", vmin=-1, vmax=1)\n",
    "plt.title(\"Correlation heatmap (numerical variables and churn)\")\n",
    "savefig(\"fig_correlation\")\n",
    "\n",
    "rate_rows = []\n",
    "for col in [\"Contract\", \"InternetService\", \"PaymentMethod\", \"OnlineSecurity\", \"TechSupport\", \"SeniorCitizen\", \"gender\"]:\n",
    "    g = df.assign(c=y).groupby(col)[\"c\"].agg([\"size\", \"mean\"])\n",
    "    for k, r in g.iterrows():\n",
    "        rate_rows.append({\"Characteristic\": col, \"Category\": k, \"Customers\": int(r[\"size\"]), \"Churn rate %\": round(100 * r[\"mean\"], 1)})\n",
    "tg = pd.cut(df[\"tenure\"], [0, 12, 24, 48, 72], labels=[\"0-12\", \"13-24\", \"25-48\", \"49-72\"])\n",
    "for k, r in df.assign(c=y, tg=tg).groupby(\"tg\")[\"c\"].agg([\"size\", \"mean\"]).iterrows():\n",
    "    rate_rows.append({\"Characteristic\": \"Tenure group\", \"Category\": k, \"Customers\": int(r[\"size\"]), \"Churn rate %\": round(100 * r[\"mean\"], 1)})\n",
    "rate_table = pd.DataFrame(rate_rows)\n",
    "rate_table.to_csv(\"results/churn_rate_by_group.csv\", index=False)\n",
    "rate_table"
   ]
